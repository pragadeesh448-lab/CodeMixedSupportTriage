FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Build the trained model artifacts into the deployment image.
RUN python train_model.py

# Vercel supplies PORT; fall back to 80 for local/container compatibility.
CMD ["sh", "-c", "streamlit run app.py --server.address 0.0.0.0 --server.port ${PORT:-80} --server.headless true --server.enableCORS false"]
